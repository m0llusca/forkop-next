  "narrative": {
    "overview": "Forkop is a Russian-first operating interface inside LuCI. Its approved direction combines a connection-first home with a persistent six-section workspace: Главная, Серверы, Правила, Устройства, Диагностика, Настройки. Local secondary navigation keeps related tools within their task.\n\nThe visual system uses slate surfaces, a restrained mint/teal accent, local inherited typography, open divisions and explicit native controls. The same hierarchy serves desktop and phone; status text distinguishes evidence from assumptions. No ornamental imagery is part of this system.",
    "keyCharacteristics": [
      "Connection state, selected outgoing server and deliberate checking remain distinct.",
      "Open sections and thin separators organize dense operational content.",
      "Native LuCI forms retain their behavior and draft state.",
      "Light and dark themes share hierarchy, readable states and labeled controls."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "A running service, selected outbound, previous latency and an explicit network probe are separate evidence. Color never substitutes for their labels.",
        "section": "colors"
      },
      {
        "name": "The Scoped Host Rule",
        "body": "Scope new CSS to `.fkp-workspace`, `.fkp-next` or positively identified `.fkp-workspace-modal`. Strong host-theme overrides are bounded by `#cbi-forkop.fkp-workspace[data-theme]` and `#modal_overlay .fkp-workspace-modal[data-theme]`; never style generic LuCI headers or other applications.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve native fields, activation authorities and validation-location feedback.",
      "Do use the active theme consistently inside the workspace and identified dialogs.",
      "Do keep status meaning explicit and unknown measurements distinct from zero.",
      "Do retain the mobile navigation, stacked form labels and targeted table adaptation.",
      "Do respect reduced motion and visible keyboard focus."
    ],
    "donts": [
      "Don't infer connection success from a running process, selected server or version check.",
      "Don't invent live metrics or expose deployment credentials and private endpoint metadata.",
      "Don't let Forkop styling escape into surrounding LuCI applications.",
      "Don't introduce remote fonts, ornamental imagery or a new token palette.",
      "Don't treat static screenshot review as proof of router installation or performance."
    ]
  }
}

+func TestRealityRecordHandshakeCancellationReleasesBlockedWrite(t *testing.T) {
+	opts, _ := realityRecordOptions(t, 256)
+	config, err := newRealityClient(context.Background(), logger.NOP(), "", opts, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	finished := make(chan error, 1)
+	signaled := &realityWriteSignalConn{Conn: client, entered: make(chan struct{})}
+	go func() { _, err := config.(*RealityClientConfig).ClientHandshake(ctx, signaled); finished <- err }()
+	select {
+	case <-signaled.entered:
+	case <-time.After(time.Second):
+		t.Fatal("handshake did not enter underlying Write")
+	}
+	cancel()
+	select {
+	case err := <-finished:
+		if err == nil {
+			t.Fatal("canceled handshake succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("canceled handshake left blocked record write")
+	}
+}

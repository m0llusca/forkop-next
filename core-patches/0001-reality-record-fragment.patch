+// Decrypt exactly the authenticated session ID as the REALITY peer would. This
+// validates the actual emitted hello, not a separate synthetic TLS constructor.
+func decryptRealityHello(hello []byte, key *ecdh.PrivateKey) ([]byte, error) {
+	if len(hello) < 75 || hello[0] != 1 || hello[38] != 32 {
+		return nil, io.ErrUnexpectedEOF
+	}
+	i := 39 + int(hello[38])
+	if i+2 > len(hello) {
+		return nil, io.ErrUnexpectedEOF
+	}
+	i += 2 + int(binary.BigEndian.Uint16(hello[i:i+2]))
+	if i >= len(hello) {
+		return nil, io.ErrUnexpectedEOF
+	}
+	i += 1 + int(hello[i])
+	if i+2 > len(hello) {
+		return nil, io.ErrUnexpectedEOF
+	}
+	end := i + 2 + int(binary.BigEndian.Uint16(hello[i:i+2]))
+	i += 2
+	if end != len(hello) {
+		return nil, io.ErrUnexpectedEOF
+	}
+	var peer []byte
+	for i+4 <= end {
+		kind := binary.BigEndian.Uint16(hello[i : i+2])
+		n := int(binary.BigEndian.Uint16(hello[i+2 : i+4]))
+		i += 4
+		if i+n > end {
+			return nil, io.ErrUnexpectedEOF
+		}
+		if kind == 51 {
+			if n < 2 {
+				return nil, io.ErrUnexpectedEOF
+			}
+			for j := i + 2; j+4 <= i+n; {
+				group := binary.BigEndian.Uint16(hello[j : j+2])
+				length := int(binary.BigEndian.Uint16(hello[j+2 : j+4]))
+				j += 4
+				if j+length > i+n {
+					return nil, io.ErrUnexpectedEOF
+				}
+				if group == 29 && length == 32 {
+					peer = hello[j : j+length]
+				}
+				j += length
+			}
+		}
+		i += n
+	}
+	if peer == nil {
+		return nil, io.ErrUnexpectedEOF
+	}
+	public, err := ecdh.X25519().NewPublicKey(peer)
+	if err != nil {
+		return nil, err
+	}
+	shared, err := key.ECDH(public)
+	if err != nil {
+		return nil, err
+	}
+	auth := make([]byte, 32)
+	if _, err = hkdf.New(sha256.New, shared, hello[6:26], []byte("REALITY")).Read(auth); err != nil {
+		return nil, err
+	}
+	block, err := aes.NewCipher(auth)
+	if err != nil {
+		return nil, err
+	}
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+	aad := append([]byte(nil), hello...)
+	clear(aad[39:71])
+	return gcm.Open(nil, hello[26:38], hello[39:71], aad)
+}

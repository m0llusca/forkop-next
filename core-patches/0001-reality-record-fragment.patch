+	"golang.org/x/crypto/hkdf"
+)
+
+type realityCaptureConn struct {
+	bytes.Buffer
+	writes int
+}
+
+type realityWriteSignalConn struct {
+	net.Conn
+	entered chan struct{}
+	once    sync.Once
+}
+
+func (c *realityWriteSignalConn) Write(p []byte) (int, error) {
+	c.once.Do(func() { close(c.entered) })
+	return c.Conn.Write(p)
+}
+
+func (c *realityCaptureConn) Write(p []byte) (int, error)      { c.writes++; return c.Buffer.Write(p) }
+func (c *realityCaptureConn) Read(p []byte) (int, error)       { return 0, io.EOF }
+func (c *realityCaptureConn) Close() error                     { return nil }
+func (c *realityCaptureConn) LocalAddr() net.Addr              { return nil }
+func (c *realityCaptureConn) RemoteAddr() net.Addr             { return nil }
+func (c *realityCaptureConn) SetDeadline(time.Time) error      { return nil }
+func (c *realityCaptureConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *realityCaptureConn) SetWriteDeadline(time.Time) error { return nil }
+
+func realityRecordOptions(t *testing.T, size uint16) (option.OutboundTLSOptions, *ecdh.PrivateKey) {
+	t.Helper()
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return option.OutboundTLSOptions{Enabled: true, ServerName: "fixture.invalid",
+		UTLS:    &option.OutboundUTLSOptions{Enabled: true, Fingerprint: "chrome"},
+		Reality: &option.OutboundRealityOptions{Enabled: true, PublicKey: base64.RawURLEncoding.EncodeToString(key.PublicKey().Bytes()), ShortID: "aabb", SupportX25519MLKEM768: true, RecordFragmentSize: size}}, key
+}
+
+func TestRealityRecordValidationAndClone(t *testing.T) {
+	for _, size := range []uint16{0, 1, 256, 16384, 16385, 65535} {
+		opts, _ := realityRecordOptions(t, size)
+		config, err := newRealityClient(context.Background(), logger.NOP(), "", opts, false)
+		if size > 16384 {
+			if err == nil {
+				t.Fatalf("accepted size%d", size)
+			}
+			continue
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		reality := config.(*RealityClientConfig)
+		clone := reality.Clone().(*RealityClientConfig)
+		if clone.recordFragmentSize != size || clone.supportX25519MLKEM768 != reality.supportX25519MLKEM768 || clone.shortID != reality.shortID || !bytes.Equal(clone.publicKey, reality.publicKey) {
+			t.Fatal("Clone lost security/fragment options")
+		}
+		if clone.uClient == reality.uClient {
+			t.Fatal("Clone shares mutable uTLS config")
+		}
+	}
+}
+
+func TestRealityRecordOptionJSON(t *testing.T) {
+	encoded, err := json.Marshal(option.OutboundRealityOptions{Enabled: true})
+	if err != nil || bytes.Contains(encoded, []byte("record_fragment_size")) {
+		t.Fatal("default option changed serialized config")
+	}
+	var options option.OutboundRealityOptions
+	if err = json.Unmarshal([]byte(`{"record_fragment_size":256}`), &options); err != nil || options.RecordFragmentSize != 256 {
+		t.Fatal("opt-in option did not decode")
+	}
+	for _, input := range []string{`{"record_fragment_size":-1}`, `{"record_fragment_size":65536}`, `{"record_fragment_size":1.5}`} {
+		if json.Unmarshal([]byte(input), &options) == nil {
+			t.Fatal("invalid integer option accepted")
+		}
+	}
+}
+
+func TestRealityRecordActualAuthenticatedClientHello(t *testing.T) {
+	for _, size := range []uint16{0, 256} {
+		opts, key := realityRecordOptions(t, size)
+		config, err := newRealityClient(context.Background(), logger.NOP(), "", opts, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		capture := &realityCaptureConn{}
+		_, err = config.(*RealityClientConfig).ClientHandshake(context.Background(), capture)
+		if err == nil {
+			t.Fatal("EOF peer unexpectedly authenticated")
+		}
+		wire := capture.Bytes()
+		var hello []byte
+		records := 0
+		for len(wire) > 0 {
+			if len(wire) < 5 || wire[0] != 22 {
+				t.Fatal("expected plaintext handshake records only")
+			}
+			n := int(binary.BigEndian.Uint16(wire[3:5]))
+			if n == 0 || len(wire) < 5+n {
+				t.Fatal("invalid output record")
+			}
+			if size != 0 && n > int(size) {
+				t.Fatalf("wiring ignored size%d: record%d", size, n)
+			}
+			hello = append(hello, wire[5:5+n]...)
+			wire = wire[5+n:]
+			records++
+		}
+		if size == 0 && (records != 1 || capture.writes != 1) {
+			t.Fatal("default wire record/write shape changed")
+		}
+		if size != 0 && records < 2 {
+			t.Fatal("opt-in did not split actual ClientHello")
+		}
+		plain, err := decryptRealityHello(hello, key)
+		if err != nil {
+			t.Fatalf("reassembled ClientHello authentication failed: %v", err)
+		}
+		if !bytes.Equal(plain[8:16], []byte{0xaa, 0xbb, 0, 0, 0, 0, 0, 0}) {
+			t.Fatal("short ID changed")
+		}
+		if !bytes.Equal(plain[:3], []byte{26, 7, 11}) {
+			t.Fatal("REALITY client version changed")
+		}
+		wrongKey, err := ecdh.X25519().GenerateKey(rand.Reader)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err = decryptRealityHello(hello, wrongKey); err == nil {
+			t.Fatal("wrong server key authenticated")
+		}
+		mutated := append([]byte(nil), hello...)
+		mutated[45] ^= 1
+		if _, err = decryptRealityHello(mutated, key); err == nil {
+			t.Fatal("modified authentication bytes accepted")
+		}
+		mutated = append([]byte(nil), hello...)
+		mutated[len(mutated)-1] ^= 1
+		if _, err = decryptRealityHello(mutated, key); err == nil {
+			t.Fatal("modified ClientHello authenticated data accepted")
+		}
+	}
+}

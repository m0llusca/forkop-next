// Versioned schema adapter. GPL-2.0-or-later.
// Response-matching and HTTP-client migration follows official sing-box 1.14
// migration docs; source-aware bypass shape also studied in Trafira generator.
function object(x){return type(x)=='object'?x:{};}
function array(x){return type(x)=='array'?x:[];}
function clone(x){return json(sprintf('%J',x));}
function has_address(rule){
    if(rule.match_response)return false;
    if(rule.ip_cidr!=null||rule.ip_is_private!=null)return true;
    for(let child in array(rule.rules))if(has_address(child))return true;
    return false;
}
function mark_response(rule){
    if(rule.ip_cidr!=null||rule.ip_is_private!=null)rule.match_response=true;
    for(let child in array(rule.rules))mark_response(child);
}
function transform(config,version){
    let m=match(''+(version||''),/^v?([0-9]+)\.([0-9]+)\.([0-9]+)/);
    // Unknown runtime keeps the legacy shape for the real core's mandatory check.
    if(!m||int(m[1])<1||(int(m[1])==1&&int(m[2])<14))return config;
    let dns=object(config.dns),rules=[];
    delete dns.independent_cache;
    for(let original in array(dns.rules)){
        let rule=clone(original);
        if(!has_address(rule)){push(rules,rule);continue;}
        // Generated bypass: all request conditions AND one inverted FakeIP filter.
        // Never broaden an OR expression or invert a whole logical condition.
        if(rule.type!='logical'||rule.mode!='and'||rule.invert||length(array(rule.rules))!=2||has_address(rule.rules[0])||!has_address(rule.rules[1])||rule.action!='route'||!rule.server)
            die('unsupported_dns_response_migration');
        let evaluate=clone(rule.rules[0]);evaluate.action='evaluate';evaluate.server=rule.server;
        for(let field in ['rewrite_ttl','disable_cache','client_subnet'])if(rule[field]!=null)evaluate[field]=rule[field];
        push(rules,evaluate);mark_response(rule);
        rule.action='respond';delete rule.server;delete rule.rewrite_ttl;delete rule.disable_cache;delete rule.client_subnet;
        push(rules,rule);
    }
    if(config.dns)dns.rules=rules;
    let route=object(config.route),has_remote=false;
    for(let rs in array(route.rule_set)){
        if(rs.type!='remote')continue;
        has_remote=true;
        if(rs.http_client==null)rs.http_client=rs.download_detour?{detour:rs.download_detour}:{};
        delete rs.download_detour;
    }
    if(has_remote&&!route.default_http_client){
        if(type(config.http_clients)!='array')config.http_clients=[];
        let tag='forkop-ruleset-http',exists=false;
        for(let client in config.http_clients)if(client.tag==tag)exists=true;
        if(!exists)push(config.http_clients,{tag});
        route.default_http_client=tag;
    }
    return config;
}
return {transform};
